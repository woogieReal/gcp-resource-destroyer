# ==========================================
# 1. OS & IDE (시스템 임시 파일)
# ==========================================
.DS_Store
Thumbs.db
.vscode/
.idea/

# ==========================================
# 2. NodeJS / Runtime (API 서버 및 런타임)
# ==========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/

# ==========================================
# 3. Terraform (인프라 정의 파일)
# ==========================================
# 로컬 테라폼 전용 디렉토리
.terraform/

# 로컬에 생성되는 상태(State) 파일 (우리는 GCS 원격 백엔드를 쓰므로 업로드 금지)
*.tfstate
*.tfstate.*

# 테라폼 실행 시 생성되는 백업 및 충돌 파일
crash.log
crash.*

# 테라폼 변수 파일 (민감한 실습용 변수가 담길 수 있음)
*.tfvars
*.tfvars.json

# 일시적인 테라폼 플랜 결과물
*.tfplan

# override 파일 (로컬 환경 오버라이드용)
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ==========================================
# 4. Environment / Secrets (보안 세크리트)
# ==========================================
.env
.env.local
.env.*.local
*.pem
*.key
*.json
# 단, 패키지 관리를 위한 package.json 이나 tsconfig.json 등은 당연히 제외됩니다.